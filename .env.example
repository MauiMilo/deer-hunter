# Deer Scout needs no API keys or accounts. Every data source is free and public.
# These optional settings change how the pipeline runs.

# Where terrain elevation comes from:
#   cog         = USGS 3DEP 1/3 arc-second (~10 m) cloud-optimized GeoTIFFs on USGS's public S3 bucket (default)
#   imageserver = USGS 3DEP ImageServer (any resolution, but often slow or erroring under load)
DEERSCOUT_DEM_SOURCE=cog

# Elevation sampling for terrain analysis, in meters per pixel (default 10, matching the S3 files).
DEERSCOUT_DEM_RES_M=10
